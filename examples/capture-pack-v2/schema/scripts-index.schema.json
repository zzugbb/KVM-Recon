{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kvm-recon.local/schema/2.0/scripts-index.schema.json",
  "title": "KVM-Recon Capture Pack 2.0 raw/scripts/index.json",
  "type": "object",
  "required": ["schemaVersion", "scripts"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "scripts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "url", "targetId"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "network-script",
              "inline",
              "eval",
              "function",
              "blob",
              "data",
              "worker",
              "shared-worker",
              "service-worker",
              "wasm",
              "source-map"
            ]
          },
          "url": { "type": ["string", "null"] },
          "targetId": { "type": ["string", "null"] },
          "createdBy": { "type": "string" },
          "bodyRef": {
            "type": "object",
            "required": ["sha256", "bytes", "path"],
            "additionalProperties": false,
            "properties": {
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "bytes": { "type": "integer", "minimum": 0 },
              "path": { "type": "string", "minLength": 1 }
            }
          },
          "sourceMapPath": { "type": "string" }
        }
      }
    }
  }
}
