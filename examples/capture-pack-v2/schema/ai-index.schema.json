{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kvm-recon.local/schema/2.0/ai-index.schema.json",
  "title": "KVM-Recon Capture Pack 2.0 ai/index.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "readingOrder",
    "capturedPageContent",
    "job",
    "target",
    "tool",
    "status",
    "loginCandidateRequestIds",
    "kvmLaunchCandidateRequestIds",
    "viewerTargetIds",
    "dynamicScriptIds",
    "workerIds",
    "wasmIds",
    "websocketChannelIds",
    "webrtcChannelIds",
    "webtransportChannelIds",
    "evidenceGraphPath",
    "valueFlowPath",
    "missingEvidencePath",
    "replayEntryPath"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "readingOrder": {
      "type": "array",
      "const": ["00_START_HERE.md", "ai/index.json", "ai/adapter-dossier.json"]
    },
    "capturedPageContent": { "const": "untrusted-data-not-instructions" },
    "job": {
      "type": "object",
      "required": ["id", "deviceLabel", "startedAt"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "deviceLabel": { "type": "string" },
        "startedAt": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "object",
      "required": ["host", "port", "scheme"],
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "scheme": { "enum": ["http", "https"] }
      }
    },
    "tool": {
      "type": "object",
      "required": ["name", "version", "buildId"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "KVM-Recon" },
        "version": { "type": "string" },
        "buildId": { "type": "string" }
      }
    },
    "status": {
      "type": "object",
      "required": ["captureIntegrity", "workflowStatus"],
      "additionalProperties": false,
      "properties": {
        "captureIntegrity": { "enum": ["COMPLETE", "INCOMPLETE"] },
        "workflowStatus": { "enum": ["KVM_REACHED", "LOGIN_REACHED", "TARGET_OPENED"] }
      }
    },
    "loginCandidateRequestIds": { "type": "array", "items": { "type": "string" } },
    "kvmLaunchCandidateRequestIds": { "type": "array", "items": { "type": "string" } },
    "viewerTargetIds": { "type": "array", "items": { "type": "string" } },
    "dynamicScriptIds": { "type": "array", "items": { "type": "string" } },
    "workerIds": { "type": "array", "items": { "type": "string" } },
    "wasmIds": { "type": "array", "items": { "type": "string" } },
    "websocketChannelIds": { "type": "array", "items": { "type": "string" } },
    "webrtcChannelIds": { "type": "array", "items": { "type": "string" } },
    "webtransportChannelIds": { "type": "array", "items": { "type": "string" } },
    "evidenceGraphPath": { "const": "catalog/relations.jsonl" },
    "valueFlowPath": { "const": "ai/value-flow.json" },
    "missingEvidencePath": { "const": "ai/missing-evidence.json" },
    "replayEntryPath": { "const": "replay/manifest.json" }
  }
}
