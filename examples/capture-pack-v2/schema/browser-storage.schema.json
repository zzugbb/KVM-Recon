{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kvm-recon.local/schema/2.0/browser-storage.schema.json",
  "title": "KVM-Recon Capture Pack 2.0 raw/browser/storage.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "targetId",
    "capturedAt",
    "cookies",
    "localStorage",
    "sessionStorage",
    "indexedDb",
    "cacheStorage"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "targetId": { "type": "string", "minLength": 1 },
    "capturedAt": { "type": "string", "minLength": 1 },
    "cookies": { "type": "array", "items": { "type": "object" } },
    "localStorage": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "sessionStorage": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "indexedDb": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["database", "objectStore", "record"],
        "additionalProperties": false,
        "properties": {
          "database": { "type": "string", "minLength": 1 },
          "objectStore": { "type": "string", "minLength": 1 },
          "record": true
        }
      }
    },
    "cacheStorage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["origin", "cacheName", "requestUrl"],
        "additionalProperties": false,
        "properties": {
          "origin": { "type": "string", "minLength": 1 },
          "cacheName": { "type": "string", "minLength": 1 },
          "requestUrl": { "type": "string", "minLength": 1 },
          "responseRef": {
            "type": "object",
            "required": ["sha256", "bytes", "path"],
            "additionalProperties": false,
            "properties": {
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "bytes": { "type": "integer", "minimum": 0 },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "additionalContexts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["targetId", "capturedAt", "localStorage", "sessionStorage", "indexedDb", "cacheStorage"],
        "additionalProperties": false,
        "properties": {
          "targetId": { "type": "string", "minLength": 1 },
          "capturedAt": { "type": "string", "minLength": 1 },
          "localStorage": { "type": "object", "additionalProperties": { "type": "string" } },
          "sessionStorage": { "type": "object", "additionalProperties": { "type": "string" } },
          "indexedDb": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["database", "objectStore", "record"],
              "additionalProperties": false,
              "properties": {
                "database": { "type": "string", "minLength": 1 },
                "objectStore": { "type": "string", "minLength": 1 },
                "record": true
              }
            }
          },
          "cacheStorage": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["origin", "cacheName", "requestUrl"],
              "additionalProperties": false,
              "properties": {
                "origin": { "type": "string", "minLength": 1 },
                "cacheName": { "type": "string", "minLength": 1 },
                "requestUrl": { "type": "string", "minLength": 1 },
                "responseRef": {
                  "type": "object",
                  "required": ["sha256", "bytes", "path"],
                  "additionalProperties": false,
                  "properties": {
                    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "bytes": { "type": "integer", "minimum": 0 },
                    "path": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
