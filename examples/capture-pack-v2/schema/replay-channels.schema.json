{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kvm-recon.local/schema/2.0/replay-channels.schema.json",
  "title": "KVM-Recon Capture Pack 2.0 replay/channels.json",
  "type": "object",
  "required": ["schemaVersion", "channels"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["channelId", "kind", "framesIndexPath", "requiresDynamicValueIds"],
        "additionalProperties": false,
        "properties": {
          "channelId": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["websocket", "webrtc", "webtransport", "sse", "download", "other"]
          },
          "framesIndexPath": { "type": ["string", "null"] },
          "requiresDynamicValueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
