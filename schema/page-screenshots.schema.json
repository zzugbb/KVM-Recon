{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kvm-recon.local/schema/page-screenshots.schema.json",
  "title": "KVM-Recon page screenshot index",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["path", "role"],
    "properties": {
      "path": { "type": "string" },
      "role": { "enum": ["login", "home", "kvm-entry", "viewer", "error", "unknown"] }
    }
  }
}
