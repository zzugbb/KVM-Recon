{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kvm-recon.local/schema/network-capture-status.schema.json",
  "title": "KVM-Recon network capture status",
  "type": "object",
  "required": ["timedOut", "pendingTaskCount", "inFlightRequestIds"],
  "properties": {
    "timedOut": { "type": "boolean" },
    "pendingTaskCount": { "type": "integer", "minimum": 0 },
    "inFlightRequestIds": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "attachFailures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sessionId", "reason"],
        "properties": {
          "sessionId": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
