{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kvm-recon.local/schema/network-capture-status.schema.json",
  "title": "KVM-Recon network capture status",
  "type": "object",
  "required": ["timedOut", "pendingTaskCount", "inFlightRequestIds"],
  "properties": {
    "timedOut": { "type": "boolean" },
    "pendingTaskCount": { "type": "integer", "minimum": 0 },
    "pendingTasks": {
      "type": "array",
      "description": "In-flight CDP tasks with request id and kind. Readiness only degrades for login, KVM launch/token, Viewer/Worker source, or target-attach.",
      "items": {
        "type": "object",
        "required": ["kind"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["response-body", "request-body", "target-attach", "unknown"]
          },
          "requestId": { "type": "string" }
        }
      }
    },
    "inFlightRequestIds": {
      "type": "array",
      "description": "All in-flight HTTP request IDs at export time, including duplicate BMC polls. Readiness only degrades for material unique gaps.",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "attachFailures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sessionId", "reason"],
        "properties": {
          "sessionId": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
