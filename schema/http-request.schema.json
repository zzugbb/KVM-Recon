{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kvm-recon.local/schema/http-request.schema.json",
  "title": "KVM-Recon HTTP request summary",
  "type": "object",
  "required": ["id", "timestamp", "method", "url", "resourceType", "status", "tags"],
  "properties": {
    "id": { "type": "string" },
    "timestamp": { "type": "string" },
    "method": { "type": "string" },
    "url": { "type": "string" },
    "resourceType": { "type": "string" },
    "status": { "type": ["integer", "null"] },
    "requestHeaders": { "type": "object" },
    "responseHeaders": { "type": "object" },
    "requestBodySummary": { "$ref": "#/definitions/bodySummary" },
    "responseBodySummary": { "$ref": "#/definitions/bodySummary" },
    "responseContentType": { "type": "string" },
    "redirectLocation": { "type": "string" },
    "responseStructure": {
      "type": "object",
      "properties": {
        "bodyKind": { "enum": ["json-object", "json-array", "text", "html", "empty", "other"] },
        "jsonKeys": {
          "type": "array",
          "items": { "type": "string" }
        },
        "jsonShape": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "jsonPaths": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": { "enum": ["login", "kvm-token", "kvm-entry"] }
    },
    "windowRole": { "enum": ["main", "popup"] }
  },
  "definitions": {
    "bodySummary": {
      "type": "object",
      "properties": {
        "bytes": { "type": "integer" },
        "redactedFields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "jsonKeys": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sample": {}
      }
    }
  }
}
