{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kvm-recon.local/schema/page-storage.schema.json",
  "title": "KVM-Recon page storage key snapshot",
  "type": "object",
  "required": ["localStorageKeys", "sessionStorageKeys", "windowRole", "windowRoles", "snapshots"],
  "properties": {
    "localStorageKeys": { "type": "array", "items": { "type": "string" } },
    "sessionStorageKeys": { "type": "array", "items": { "type": "string" } },
    "localStorageAdded": { "type": "array", "items": { "type": "string" } },
    "localStorageRemoved": { "type": "array", "items": { "type": "string" } },
    "sessionStorageAdded": { "type": "array", "items": { "type": "string" } },
    "sessionStorageRemoved": { "type": "array", "items": { "type": "string" } },
    "windowRole": { "enum": ["main", "popup"] },
    "windowRoles": {
      "type": "array",
      "items": { "enum": ["main", "popup"] },
      "uniqueItems": true
    },
    "captureWindowIds": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "windowRole",
          "captureRole",
          "localStorageKeys",
          "sessionStorageKeys",
          "localStorageAdded",
          "localStorageRemoved",
          "sessionStorageAdded",
          "sessionStorageRemoved"
        ],
        "properties": {
          "windowRole": { "enum": ["main", "popup"] },
          "captureWindowId": { "type": "string" },
          "captureRole": { "enum": ["login", "home", "kvm-entry", "viewer", "error", "unknown"] },
          "localStorageKeys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "sessionStorageKeys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "localStorageAdded": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "localStorageRemoved": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "sessionStorageAdded": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "sessionStorageRemoved": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
