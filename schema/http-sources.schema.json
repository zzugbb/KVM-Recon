{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kvm-recon.local/schema/http-sources.schema.json",
  "title": "KVM-Recon captured HTML/JS source inventory",
  "type": "object",
  "required": ["files"],
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "kind", "sha256", "bytes", "truncated", "path"],
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string" },
          "kind": { "enum": ["javascript", "html"] },
          "sha256": { "type": "string" },
          "bytes": { "type": "integer" },
          "truncated": { "type": "boolean" },
          "path": { "type": "string" },
          "captureWindowId": { "type": "string" },
          "windowRole": { "enum": ["main", "popup"] }
        }
      }
    },
    "referenced": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "kind", "captured", "missing"],
        "properties": {
          "url": { "type": "string" },
          "kind": { "enum": ["javascript", "html"] },
          "initiator": { "type": "string" },
          "required": { "type": "boolean" },
          "captured": { "type": "boolean" },
          "missing": { "type": "boolean" },
          "requestId": { "type": "string" },
          "captureWindowId": { "type": "string" },
          "windowRole": { "enum": ["main", "popup"] }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "requestId", "reason"],
        "properties": {
          "url": { "type": "string" },
          "requestId": { "type": "string" },
          "bytes": { "type": "integer" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
