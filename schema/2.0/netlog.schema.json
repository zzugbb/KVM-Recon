{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kvm-recon.local/schema/2.0/netlog.schema.json",
  "title": "KVM-Recon Capture Pack 2.0 raw/netlog/netlog.json",
  "type": "object",
  "required": ["schemaVersion", "captureMode", "events"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "captureMode": { "type": "string", "minLength": 1 },
    "events": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    }
  }
}
