{
  "name": "kvm-recon",
  "version": "0.2.5",
  "description": "Offline BMC/KVM Discovery & Compatibility Toolkit / KVM 离线探测与兼容性采集工具。",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:mac": "npm run build && cross-env ELECTRON_CACHE=.cache/electron ELECTRON_BUILDER_CACHE=.cache/electron-builder electron-builder --mac --publish never",
    "package:win": "npm run build && cross-env ELECTRON_CACHE=.cache/electron ELECTRON_BUILDER_CACHE=.cache/electron-builder electron-builder --win --publish never",
    "package:dir": "npm run build && cross-env ELECTRON_CACHE=.cache/electron ELECTRON_BUILDER_CACHE=.cache/electron-builder electron-builder --dir --publish never --config.electronDist=node_modules/electron/dist",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/launch-app.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzugbb/KVM-Recon.git"
  },
  "keywords": [
    "kvm",
    "bmc",
    "html5-kvm",
    "redfish",
    "electron",
    "offline",
    "capture-pack"
  ],
  "author": "KVM-Recon contributors",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/zzugbb/KVM-Recon/issues"
  },
  "homepage": "https://github.com/zzugbb/KVM-Recon#readme",
  "dependencies": {
    "jszip": "^3.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.kvmrecon.desktop",
    "productName": "KVM-Recon",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "publish": {
      "provider": "github",
      "owner": "zzugbb",
      "repo": "KVM-Recon"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "README.md",
      "README.zh-CN.md",
      "docs/**/*",
      "examples/**/*",
      "schema/**/*"
    ],
    "asar": true,
    "afterPack": "scripts/afterPack.cjs",
    "mac": {
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
